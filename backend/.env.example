# Public website origin. OAuth callbacks are served from this same origin.
BLOOM_SITE_URL=https://bloomclient.org

# Generate independently for production. Never commit the real value.
BLOOM_AUTH_SECRET=
BLOOM_AUTH_DATA_DIR=/var/lib/bloom/accounts

# Google Cloud OAuth web client
BLOOM_GOOGLE_CLIENT_ID=
BLOOM_GOOGLE_CLIENT_SECRET=

# GitHub OAuth App
BLOOM_GITHUB_CLIENT_ID=
BLOOM_GITHUB_CLIENT_SECRET=
