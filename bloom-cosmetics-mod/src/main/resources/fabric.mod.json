{
  "schemaVersion": 1,
  "id": "bloom_cosmetics",
  "version": "${version}",
  "name": "Delight Cosmetics & Tweaks",
  "icon": "assets/bloom_cosmetics/icon.png",
  "description": "Delight cosmetics, emotes and in-game tweaks. Open Delight Tweaks from Options or press Right Shift in a world. Client-side, for Fabric Minecraft ${minecraft}.",
  "authors": ["Delight Client"],
  "contact": {
    "homepage": "https://delightproductions.org",
    "sources": "https://github.com/Parksdotjar/BloomClient-V2"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["org.bloomclient.cosmetics.BloomCosmeticsClient", "org.bloomclient.cosmetics.tweaks.DelightTweaks"]
  },
  "mixins": [
    {
      "config": "bloom-cosmetics.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${minimumLoader}",
    "player_animation_library": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  }
}
