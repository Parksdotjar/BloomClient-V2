{
  "schemaVersion": 1,
  "id": "bloom_cosmetics",
  "version": "${version}",
  "name": "Bloom Cosmetics",
  "icon": "assets/bloom_cosmetics/icon.png",
  "description": "Bloom capes, nametag badges, and multiplayer emotes. Press B for the emote wheel. Client-side, for Fabric Minecraft ${minecraft}.",
  "authors": ["Bloom Client"],
  "contact": {
    "homepage": "https://bloomclient.org",
    "sources": "https://github.com/Parksdotjar/BloomClient-V2"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["org.bloomclient.cosmetics.BloomCosmeticsClient"]
  },
  "mixins": [
    {
      "config": "bloom-cosmetics.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${minimumLoader}",
    "player_animation_library": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  }
}
