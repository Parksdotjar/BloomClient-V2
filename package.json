    "@tauri-apps/plugin-updater": "^2.10.1",
    "@zxing/browser": "^0.2.1",
    "animate.css": "^4.1.1",
    "animejs": "^4.5.0",
    "fflate": "0.8.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
