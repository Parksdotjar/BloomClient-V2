{
  "name": "delight-client-v2",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cosmetics": "node scripts/build-cosmetics-mod.mjs",
