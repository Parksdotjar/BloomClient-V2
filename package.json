    "dev:tauri": "npm run build:cosmetics && npm run dev",
    "typecheck": "tsc --noEmit",
    "test:social-state": "node --experimental-strip-types --test tests/social-message-state.test.ts",
    "test:theme": "node scripts/audit-theme.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "mac:dev": "node scripts/macos.mjs dev",
    "mac:check": "node scripts/macos.mjs check",
    "mac:build": "node scripts/macos.mjs build",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.2.7",
