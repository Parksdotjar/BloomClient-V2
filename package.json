    "skinview3d": "^3.4.2",
    "three": "0.156.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/hast": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
